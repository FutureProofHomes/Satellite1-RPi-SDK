# image-builder/config

IMG_NAME='satellite1-rpi'
TARGET_ARCH=arm64
RELEASE='bookworm'

# Make sure our custom stage runs after stage2
STAGE_LIST="stage0 stage1 stage2 stage-sat1"

# Disable compression while testing (faster)
EXPORT_DIR=${EXPORT_DIR:-deploy}
DEPLOY_COMPRESSION=none

USE_QCOW2=1
NO_SPARSE_FILE=1

#enable config option im rpi-imager
ENABLE_CLOUDINIT=1

