--- a/scripts/package/builddeb
+++ b/scripts/package/builddeb
@@ -27,9 +27,22 @@ install_linux_image () {
 	pname=$1
 	pdir=debian/$1
 
 	# Only some architectures with OF support have this target
 	if is_enabled CONFIG_OF_EARLY_FLATTREE && [ -d "${srctree}/arch/${SRCARCH}/boot/dts" ]; then
-		${MAKE} -f ${srctree}/Makefile INSTALL_DTBS_PATH="${pdir}/usr/lib/linux-image-${KERNELRELEASE}" dtbs_install
+		${MAKE} -f ${srctree}/Makefile INSTALL_DTBS_PATH="${pdir}/usr/lib/linux-image-${KERNELRELEASE}" dtbs_install
+
+		# Ensure overlays/README is present for raspi-firmware KERNEL=auto
+		# This file lives in arch/${SRCARCH}/boot/dts/overlays/README and is
+		# not installed by dtbs_install by default.
+		overlay_src="${srctree}/arch/${SRCARCH}/boot/dts/overlays"
+		overlay_dst="${pdir}/usr/lib/linux-image-${KERNELRELEASE}/overlays"
+
+		if [ -d "${overlay_src}" ]; then
+			mkdir -p "${overlay_dst}"
+			if [ -f "${overlay_src}/README" ] && [ ! -f "${overlay_dst}/README" ]; then
+				cp "${overlay_src}/README" "${overlay_dst}/"
+			fi
+		fi
 	fi
 
 	${MAKE} -f ${srctree}/Makefile INSTALL_MOD_PATH="${pdir}" INSTALL_MOD_STRIP=1 modules_install
