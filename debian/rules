#!/usr/bin/make -f
export DH_VERBOSE=1

# Abort immediately on any recipe error
.SHELLFLAGS := -e -c

# Provide version to setuptools-scm from Debian changelog
DPKG_VERSION := $(shell dpkg-parsechangelog -ldebian/changelog --show-field Version)
UPSTREAM_VERSION := $(shell printf '%s' '$(DPKG_VERSION)' | sed 's/-[^-]*$$//')
ifndef SETUPTOOLS_SCM_PRETEND_VERSION
export SETUPTOOLS_SCM_PRETEND_VERSION := $(UPSTREAM_VERSION)
endif

# Wheelhouse build dirs (throwaway)
BUILD_VENV   := $(CURDIR)/debian/.build-venv
WHEELHOUSE   := $(CURDIR)/debian/.wheelhouse
VERIFY_VENV  := $(CURDIR)/debian/.verify-venv
LOCKED_REQUIREMENTS := $(CURDIR)/debian/.daemon-requirements.txt
NATIVE_BUILD := $(CURDIR)/debian/.native-build
NATIVE_HELPER := $(NATIVE_BUILD)/satellite1-ws281x-render
PRJ_ROOT     := /project
TARGET_PYTHON := /usr/bin/python3

# If you add 'dh-sequence-python3' to Build-Depends, you can drop '--with python3'.
%:
	dh $@ --with python3


override_dh_auto_build-arch:
	# Fresh build venv
	rm -rf $(BUILD_VENV) $(VERIFY_VENV) $(LOCKED_REQUIREMENTS) $(NATIVE_BUILD)
	$(TARGET_PYTHON) -c 'import sys; assert sys.version_info[:2] == (3, 13), sys.version'
	$(TARGET_PYTHON) -m venv $(BUILD_VENV)
	$(BUILD_VENV)/bin/pip install --requirement $(PRJ_ROOT)/debian/build-requirements.txt
	mkdir -p $(NATIVE_BUILD)
	$(MAKE) -C $(PRJ_ROOT)/native OUTPUT=$(NATIVE_HELPER)

	# Build a complete wheelhouse including the daemon extra used by the package service.
	# setuptools reuses this directory and otherwise can retain removed Python modules.
	rm -rf $(PRJ_ROOT)/build
	rm -rf $(WHEELHOUSE)
	mkdir -p $(WHEELHOUSE)
	cd $(PRJ_ROOT) && $(BUILD_VENV)/bin/uv export --locked --extra daemon --no-emit-project --format requirements-txt --output-file $(LOCKED_REQUIREMENTS)
	$(BUILD_VENV)/bin/pip wheel --no-build-isolation --require-hashes --wheel-dir $(WHEELHOUSE) --requirement $(LOCKED_REQUIREMENTS)
	$(BUILD_VENV)/bin/pip wheel --no-deps --no-build-isolation --wheel-dir $(WHEELHOUSE) $(PRJ_ROOT)

	# A release must be installable without PyPI or piwheels access on the target ABI.
	$(TARGET_PYTHON) -m venv $(VERIFY_VENV)
	$(VERIFY_VENV)/bin/pip install --no-index --only-binary=:all: --find-links=$(WHEELHOUSE) 'satellite1-rpi[daemon]'
	$(VERIFY_VENV)/bin/pip check
	$(VERIFY_VENV)/bin/satellite1d --help >/dev/null
	rm -rf $(VERIFY_VENV) $(LOCKED_REQUIREMENTS)

override_dh_auto_install-arch:
	SETUPTOOLS_USE_DISTUTILS=stdlib dh_auto_install
	for pkg in $(shell dh_listpackages); do \
	  install -d debian/$$pkg/usr/share/satellite1/wheels ; \
	  cp -a $(WHEELHOUSE)/*.whl debian/$$pkg/usr/share/satellite1/wheels/ ; \
	  install -D -m 0750 $(NATIVE_HELPER) debian/$$pkg/usr/lib/satellite1/satellite1-ws281x-render ; \
	done


# Keep the tree clean between builds
override_dh_auto_clean:
	rm -rf $(BUILD_VENV) $(VERIFY_VENV) $(WHEELHOUSE) $(LOCKED_REQUIREMENTS) $(NATIVE_BUILD)

# Don’t start the unit at install time (it will still be enabled)
override_dh_installsystemd:
	dh_installsystemd --no-start --name satellite1d
