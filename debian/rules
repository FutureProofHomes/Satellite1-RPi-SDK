#!/usr/bin/make -f
export DH_VERBOSE=1

# Abort immediately on any recipe error
.SHELLFLAGS := -e -c

# Provide version to setuptools-scm from Debian changelog
DPKG_VERSION := $(shell dpkg-parsechangelog -ldebian/changelog --show-field Version)
UPSTREAM_VERSION := $(shell echo $(DPKG_VERSION) | cut -d- -f1)
export SETUPTOOLS_SCM_PRETEND_VERSION := $(UPSTREAM_VERSION)

# Wheelhouse build dirs (throwaway)
BUILD_VENV   := $(CURDIR)/debian/.build-venv
WHEELHOUSE   := $(CURDIR)/debian/.wheelhouse
PRJ_ROOT     := /project 

# If you add 'dh-sequence-python3' to Build-Depends, you can drop '--with python3'.
%:
	dh $@ --with python3


# (No arch-specific build/install yet)
override_dh_auto_build-arch:
	# Fresh build venv
	rm -rf $(BUILD_VENV)
	python3 -m venv $(BUILD_VENV)
	$(BUILD_VENV)/bin/pip install --upgrade 'pip>=23' 'setuptools>=61.0' 'wheel' 'build'

	# Build a COMPLETE wheelhouse: your pkg + ALL deps (platform-specific wheels)
	rm -rf $(WHEELHOUSE)
	mkdir -p $(WHEELHOUSE)
	$(BUILD_VENV)/bin/python -m build --wheel --outdir $(WHEELHOUSE) $(PRJ_ROOT)

override_dh_auto_install-arch:
	SETUPTOOLS_USE_DISTUTILS=stdlib dh_auto_install
	for pkg in $(shell dh_listpackages); do \
	  install -d debian/$$pkg/usr/share/satellite1/wheels ; \
	  cp -a $(WHEELHOUSE)/*.whl debian/$$pkg/usr/share/satellite1/wheels/ ; \
	done


# Keep the tree clean between builds
override_dh_auto_clean:
	rm -rf $(BUILD_VENV) $(WHEELHOUSE)

# Don’t start the units at install time (they will still be enabled)
override_dh_installsystemd:
	dh_installsystemd --no-start --name satellite1-init
	dh_installsystemd --no-start --name satellite1-buttons
