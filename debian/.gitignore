satellite1-rpi/

# pybuild / wheel cache you created
/.wheelhouse/

# Device-tree overlay build dir created by your rules
/.dtbo-build/

# If you ever build with CMake under debian/, ignore typical build dirs
/build-*/

# python build venv
.build-venv

# --- Alternative to the explicit package line above ---
