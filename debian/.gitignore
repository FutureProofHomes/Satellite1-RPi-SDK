# debhelper / dh_* scratch
/.debhelper/
/debhelper-build-stamp
/*.debhelper.log
/*.substvars
/files
/tmp/

# Maintscript snippets generated by dh_installsystemd, etc.
/*.postinst.debhelper
/*.postrm.debhelper
/*.preinst.debhelper
/*.prerm.debhelper

# Binary package staging directories (adjust if you add more packages)
