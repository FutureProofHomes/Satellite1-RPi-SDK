#!/bin/sh
set -e

# ----- Locate firmware config + overlays dir -----
CFG=/boot/firmware/config.txt
[ -f /boot/config.txt ] && CFG=/boot/config.txt

BOOT_OVL=/boot/firmware/overlays
[ -d /boot/overlays ] && BOOT_OVL=/boot/overlays

# ----- Helpers -----

# Ensure a dtparam key=value exists; if present (even commented), replace with dtparam=key=value
ensure_dtparam() {
    key="$1"; val="$2"
    if grep -Eq "^[#[:space:]]*dtparam[[:space:]]*=[[:space:]]*${key}=" "$CFG"; then
        sed -i -E "s|^[#[:space:]]*dtparam[[:space:]]*=[[:space:]]*${key}=.*$|dtparam=${key}=${val}|" "$CFG"
    else
        printf "dtparam=%s=%s\n" "$key" "$val" >> "$CFG"
    fi
}

# Only add dtparam if key is not present in any form
ensure_dtparam_if_missing() {
    key="$1"; val="$2"
    if ! grep -Eq "^[#[:space:]]*dtparam[[:space:]]*=[[:space:]]*${key}=" "$CFG"; then
        printf "dtparam=%s=%s\n" "$key" "$val" >> "$CFG"
    fi
}

# Ensure a dtoverlay line for a specific overlay *name* (with or without params) exists
# Matches: dtoverlay=name or dtoverlay=name,<params>
ensure_overlay_name() {
    name="$1"
    if ! grep -Eq "^[#[:space:]]*dtoverlay[[:space:]]*=[[:space:]]*${name}(\\b|,)" "$CFG"; then
        printf "dtoverlay=%s\n" "$name" >> "$CFG"
    fi
}

# Ensure an exact dtoverlay line with parameters exists (e.g. "i2c-sensor,addr=0x38,chip=aht20")
ensure_overlay_line() {
    line="$1"
    if ! grep -Eq "^[#[:space:]]*dtoverlay[[:space:]]*=[[:space:]]*${line}[[:space:]]*$" "$CFG"; then
        printf "dtoverlay=%s\n" "$line" >> "$CFG"
    fi
}

# Copy all /usr/share/satellite1/overlays/*.dtbo into $BOOT_OVL if content differs
copy_overlays_to_boot() {
    src_dir="/usr/share/satellite1/overlays"
    [ -d "$src_dir" ] || return 0
    for f in "$src_dir"/*.dtbo; do
        [ -e "$f" ] || continue
        dest="$BOOT_OVL/$(basename "$f")"
        if ! cmp -s "$f" "$dest" 2>/dev/null; then
            install -D -m 0644 "$f" "$dest"
        fi
    done
}

# ----- Enable required firmware interfaces & overlays -----

# Core interfaces
ensure_dtparam spi on
ensure_dtparam i2s on
ensure_dtparam i2c_arm on
ensure_dtparam_if_missing i2c_arm_baudrate 100000

# Your I2S overlay (copied to /boot by this script)
ensure_overlay_name "satellite1-i2s"

# Optional: also attach AHT20 via generic i2c-sensor overlay (remove if not desired)
# This assumes the kernel has aht20 support (module or built-in).
ensure_overlay_line "i2c-sensor,addr=0x38,chip=aht20"

# Avoid card conflicts with legacy analog audio
sed -i -E 's/^[[:space:]]*dtparam=audio=on[[:space:]]*$/#dtparam=audio=on/' "$CFG" || true

# Copy any packaged .dtbo into /boot/*/overlays
copy_overlays_to_boot

echo "satellite1-rpi: updated $CFG and synchronized overlays to $BOOT_OVL. Reboot required." >&2

# ----- Python venv & local wheel install (if shipped) -----
VENVDIR=/opt/satellite1/venv
WHEELDIR=/usr/share/satellite1/wheels

case "$1" in
  configure|triggered)
    # 1) Create venv if missing
    if [ ! -x "$VENVDIR/bin/python3" ]; then
      mkdir -p "$(dirname "$VENVDIR")"
      /usr/bin/python3 -m venv "$VENVDIR"
    fi

    # 2) Bootstrap pip from stdlib
    "$VENVDIR/bin/python" -m ensurepip --upgrade >/dev/null 2>&1 || true

    # 3) Force offline + tell pip where deps are
    export PIP_NO_INDEX=1
    export PIP_FIND_LINKS="$WHEELDIR"
    export PIP_DISABLE_PIP_VERSION_CHECK=1
    export PIP_ROOT_USER_ACTION=ignore

    # 4) Find the wheel we ship
    WHEEL="$(
      { ls "$WHEELDIR"/satellite1_rpi-*.whl 2>/dev/null; ls "$WHEELDIR"/satellite1-rpi-*.whl 2>/dev/null; } \
      | sort -V | tail -n1
    )"
    if [ -z "$WHEEL" ]; then
      echo "postinst: ERROR: no satellite1-rpi wheel found in $WHEELDIR" >&2
      exit 1
    fi

    # 5) Install our wheel, resolving deps from our wheelhouse
    "$VENVDIR/bin/pip" install --no-index --find-links="$WHEELDIR" --force-reinstall "$WHEEL"

    # 6) (optional) byte-compile
    "$VENVDIR/bin/python" -m compileall -q "$VENVDIR/lib" || true

    # 7) (optional) systemd reload
    command -v systemctl >/dev/null 2>&1 && systemctl daemon-reload || true
    ;;
esac

BIN_DIR=/usr/bin
WRAPPERS="sat1 sat1-line-out sat1-xmos"

ensure_wrapper() {
  name="$1"
  target="$VENVDIR/bin/$name"
  dest="$BIN_DIR/$name"

  if [ -x "$target" ]; then
    # Preferred: symlink to venv console_script
    ln -sf "$target" "$dest"
  else
    # Fallback: create a tiny shim script that calls the module directly
    # Adjust module path if your entry points differ
    case "$name" in
      sat1)
        MODULE="satellite1.cli.cli_sat1"
        ;;
      sat1-line-out)
        MODULE="satellite1.cli.cli_line_out_dac"
        ;;
      sat1-xmos)
        MODULE="satellite1.cli.cli_xmos"
        ;;
      *)
        MODULE=""
        ;;
    esac
    if [ -n "$MODULE" ]; then
      cat > "$dest" <<EOF
#!/bin/sh
exec "$VENVDIR/bin/python" -m $MODULE "\$@"
EOF
      chmod 755 "$dest"
    fi
  fi
}

for w in $WRAPPERS; do
  ensure_wrapper "$w"
done
hash -r 2>/dev/null || true




exit 0
