#!/bin/sh
set -e

VENVDIR=/opt/satellite1/venv

case "$1" in
  purge)
    # Pick config.txt path (bookworm vs older)
    CFG=/boot/firmware/config.txt
    [ -f /boot/config.txt ] && CFG=/boot/config.txt

    # Remove the exact dtoverlay line if present; ignore errors if file missing
    # (Anchored with ^...$ so we don't partially match other lines)
    sed -i '/^dtoverlay=i2c-sensor,addr=0x38,chip=aht20$/d' "$CFG" || true
    # If you want to also delete a line you added explicitly:
    # sed -i '/^dtparam=i2c_arm=on$/d' "$CFG" || true

    # Remove the private venv
    if [ -d "$VENVDIR" ]; then
      rm -rf "$VENVDIR"
    fi

    # If wrappers were created dynamically, clean them up too:
    rm -f /usr/bin/sat1 /usr/bin/sat1-line-out /usr/bin/sat1-xmos
    ;;
esac

exit 0
